# ==============================================================================
# IBEN STUDIO ENTERPRISE API - ENVIRONMENT VARIABLES
# ==============================================================================

# Server configuration
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Security & CORS
JWT_SECRET=iben-studio-super-secret-key-change-in-prod
ALLOWED_ORIGINS=*

# Database storage path (:memory: for tests, or file path for persistent storage)
DATABASE_PATH=./data/iben-studio.db

# Logging
LOG_LEVEL=debug
