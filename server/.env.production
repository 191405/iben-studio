# ============================================================================
# IBEN STUDIO ENTERPRISE API — PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================================================

# Application Environment
NODE_ENV=production
PORT=10000

# CORS Security (accepts comma-separated list or * for universal access)
ALLOWED_ORIGINS=*

# API Prefix
API_PREFIX=/api/v1

# Persistent DB Path
DB_PATH=./data/iben-studio.json
